# Generated by scripts/build-hostinger.mjs. Do not edit on the server.
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Always https://www.scalewithads.us
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.scalewithads\.us$ [NC]
RewriteRule ^ https://www.scalewithads.us%{REQUEST_URI} [R=301,L]

# Permanent redirects (same list as Vercel, from redirects.json)
RewriteRule ^mvaleadgeneration/?$ /private-mastermind/personal-injury-facebook-ads [R=301,L]
RewriteRule ^snipermethod/?$ /private-mastermind/personal-injury-facebook-ads [R=301,L]
RewriteRule ^portfolio/?$ /media-library [R=301,L]
RewriteRule ^metads/?$ /services [R=301,L]
RewriteRule ^book/?$ /contact [R=301,L]
RewriteRule ^book-a-call/?$ /contact [R=301,L]
RewriteRule ^booking/?$ /contact [R=301,L]
RewriteRule ^contact-us/?$ /contact [R=301,L]
RewriteRule ^about-us/?$ /about [R=301,L]
RewriteRule ^case-studies/?$ /work [R=301,L]
RewriteRule ^roofing-leads/?$ https://www.roofingsystems.co/ [R=301,L]
RewriteRule ^facebook-ads-for-roofing-companies/?$ https://www.roofingsystems.co/facebook-ads-for-roofers [R=301,L]
RewriteRule ^case-studies/roofing-leads-3-75-cost-per-lead/?$ https://www.roofingsystems.co/case-studies/roofing-25-leads-one-day-3-75 [R=301,L]
RewriteRule ^case-studies/roofing-marketing-agency-664-leads/?$ https://www.roofingsystems.co/case-studies/roofing-agency-664-leads-4-51 [R=301,L]
RewriteRule ^case-studies/227-roofing-leads-14-cpl/?$ https://www.roofingsystems.co/case-studies/roofing-227-leads-14-cpl-28-days [R=301,L]
RewriteRule ^case-studies/florida-roofing-solar-280-leads/?$ https://www.roofingsystems.co/case-studies/florida-home-services-280-leads-15-days [R=301,L]
RewriteRule ^case-studies/roofing-marketing-agency-546k-revenue/?$ https://www.roofingsystems.co/case-studies/roofing-agency-546k-67-days [R=301,L]
RewriteRule ^case-studies/roofing-leads-154-in-15-days/?$ https://www.roofingsystems.co/case-studies/roofing-154-leads-14-58-cpl [R=301,L]
RewriteRule ^testimonials/?$ /work [R=301,L]
RewriteRule ^results/?$ /work [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^privatemastermind/coaching/?$ /meta-ads-coaching [R=301,L]
RewriteRule ^privatemastermind/?$ /private-mastermind [R=301,L]
RewriteRule ^metalto/?$ /low-ticket-funnel-case-study [R=301,L]
RewriteRule ^paidpilot/?$ /paid-pilot [R=301,L]
RewriteRule ^leadpilot/?$ /lead-pilot [R=301,L]
RewriteRule ^medialibrary/?$ /media-library [R=301,L]
RewriteRule ^features/?$ /tracking-and-attribution [R=301,L]

# Lead form endpoint
RewriteRule ^api/lead/?$ api/lead.php [L]

# Remove trailing slashes: /services/ -> /services
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Clean URLs: /services -> services.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
